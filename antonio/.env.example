# --- Serveur -----------------------------------------------------------------
NODE_ENV=development
PORT=8787
# URL de l'interface (cookies, redirections OAuth, contrôle d'origine)
APP_BASE_URL=http://localhost:5173
# URL publique de l'API (callbacks OAuth, webhooks). HTTPS requis pour les webhooks.
API_PUBLIC_URL=http://localhost:8787
DATABASE_URL=postgresql://antonio:antonio@localhost:5432/antonio_dev
# 32 octets aléatoires en base64 : openssl rand -base64 32  (OBLIGATOIRE en production)
APP_ENCRYPTION_KEY=
# Exécuter les tâches de fond dans le processus web (déploiement mono-instance)
RUN_WORKER_IN_WEB=true

# --- Abonnements Stripe (désactivés avant vérification des services réels) -----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_ENABLED=false

# --- OpenAI (texte + voix) ------------------------------------------------------
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_TEXT_REASONING=low
OPENAI_LIVE_MODEL=gpt-live-1.1

# --- Google (Gmail + Agenda) — voir docs/OAUTH.md ------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Notifications Gmail via Pub/Sub (facultatif ; sinon synchronisation périodique)
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT=

# --- Microsoft (Outlook + Calendrier) — voir docs/OAUTH.md ---------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# --- Tests sur comptes réels : seuls ces destinataires peuvent recevoir un envoi
TEST_RECIPIENT_ALLOWLIST=

{
  "name": "@antonio/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "worker:dev": "tsx watch --env-file-if-exists=../.env src/worker.ts",
    "build": "esbuild src/index.ts src/worker.ts src/migrate-cli.ts --bundle --platform=node --format=esm --packages=external --outdir=dist --sourcemap",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "worker": "node --env-file-if-exists=../.env dist/worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../.env src/migrate-cli.ts",
    "seed:demo": "tsx --env-file-if-exists=../.env src/scripts/seed-demo.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate:prod": "node --env-file-if-exists=../.env dist/migrate-cli.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.10",
    "@opentelemetry/api": "^1.9.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "jose": "6.2.18",
    "pg": "8.23.1",
    "pg-boss": "12.38.1",
    "stripe": "23.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.25.12",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}

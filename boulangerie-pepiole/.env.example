# --- Commandes en ligne ---------------------------------------------------
# Sans aucune de ces variables, le site fonctionne en « mode démonstration » :
# le parcours de commande est complet mais rien n'est transmis à la boulangerie.

# Option 1 : e-mail via Resend (https://resend.com)
RESEND_API_KEY=
# Adresse qui reçoit les commandes (la boulangerie)
ORDER_EMAIL_TO=
# Expéditeur : doit appartenir à un domaine vérifié dans Resend
ORDER_EMAIL_FROM="Le Pétrin de Pépiole <commandes@votre-domaine.fr>"

# Option 2 : webhook (Make, Zapier, n8n, Google Apps Script, Discord…)
# Reçoit la commande en JSON (POST).
ORDER_WEBHOOK_URL=

# URL publique du site (SEO / sitemap)
NEXT_PUBLIC_SITE_URL=https://petrin-de-pepiole.vercel.app

# Une adresse par boutique (prioritaire sur ORDER_EMAIL_TO)
ORDER_EMAIL_TO_SANARY=
ORDER_EMAIL_TO_SIX_FOURS=

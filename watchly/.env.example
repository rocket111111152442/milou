# =============================================================================
# WATCHLY — variables d'environnement (modèle, AUCUN secret réel ici)
# Détail de chaque variable : docs/ENVIRONMENT.md
# Application web : copier les variables utiles dans apps/web/.env.local (développement)
# ou dans les variables du projet Vercel « watchly » (Preview / Production).
# Worker : infra/docker/worker.env (voir infra/docker/worker.env.example).
# =============================================================================

# --- Application ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# preview | live : « preview » affiche le bandeau « version de démonstration » et interdit l'indexation.
NEXT_PUBLIC_LAUNCH_STATUS=preview

# --- Supabase (Auth + PostgreSQL) -----------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret serveur uniquement (jamais NEXT_PUBLIC_) : suppression de compte, administration Auth.
SUPABASE_SERVICE_ROLE_KEY=
# Connexion PostgreSQL du serveur (pooler Supabase en mode transaction en production).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Connexion directe (migrations), facultative.
DATABASE_URL_DIRECT=
DATABASE_POOL_MAX=5
# Connexion Google : n'activer qu'après configuration du fournisseur dans Supabase.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=0

# --- Sécurité -----------------------------------------------------------------
# 32 caractères minimum, aléatoire (openssl rand -hex 32). Sert à pseudonymiser e-mails/cartes (anti-abus des essais).
WATCHLY_HASH_PEPPER=
# 1 = l'administration exige la double authentification Supabase (recommandé en production).
ADMIN_REQUIRE_MFA=0

# --- Stripe (MODE TEST UNIQUEMENT) ----------------------------------------------
# Les clés sk_live_ sont refusées tant que WATCHLY_ALLOW_LIVE_PAYMENTS n'est pas renseigné
# (à ne faire qu'après validation juridique et ouverture du compte marchand).
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
# Tests uniquement : rediriger les appels vers stripe-mock (http://localhost:12111).
STRIPE_API_BASE=
WATCHLY_ALLOW_LIVE_PAYMENTS=
# Identifiants des prix Stripe (mode test), utilisés par « pnpm db:seed ».
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_BUSINESS_EXTRA_SITE=

# --- E-mails (Resend) — worker ----------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Watchly <alertes@exemple.fr>

# --- Recherche sur Internet (Brave Search API) — worker ---------------------------
BRAVE_SEARCH_API_KEY=

# --- Worker -----------------------------------------------------------------------
APP_URL=http://localhost:3000
WORKER_ID=
WORKER_ROLES=scheduler,pages,web,business,email,maintenance
WORKER_PAGE_CONCURRENCY=8
WORKER_WEB_CONCURRENCY=2
WORKER_BROWSER_CONCURRENCY=2
WORKER_BUSINESS_CONCURRENCY=16
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
LOG_LEVEL=info
# Développement / tests uniquement : autorise des cibles locales. Refusé si NODE_ENV=production.
WATCHLY_ALLOW_PRIVATE_TARGETS=0

# --- Application desktop (variables de COMPILATION) --------------------------------
# Adresse du serveur Watchly intégrée à l'application (https:// obligatoire en release).
WATCHLY_API_URL=http://localhost:3000

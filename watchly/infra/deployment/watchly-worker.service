# Alternative sans Docker : service systemd (Node 22 et Chromium installés sur le serveur).
# Installation : copier dans /etc/systemd/system/, puis
#   systemctl daemon-reload && systemctl enable --now watchly-worker
[Unit]
Description=Watchly worker (LULLIN WEB)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=watchly
WorkingDirectory=/opt/watchly/worker
EnvironmentFile=/etc/watchly/worker.env
ExecStart=/usr/bin/node --enable-source-maps /opt/watchly/worker/dist/index.js
Restart=always
RestartSec=5
# Arrêt propre : les contrôles en cours sont remis en file avant l'arrêt.
KillSignal=SIGTERM
TimeoutStopSec=60
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/watchly/worker
MemoryMax=3G

[Install]
WantedBy=multi-user.target

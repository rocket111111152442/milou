# ---------------------------------------------------------------------------
# Elvyn Arnaud Realty Group — variables d'environnement
# Copier en .env.local (local) ou les saisir dans l'hébergeur (Vercel → Settings → Environment Variables).
# Ne jamais versionner de vraie valeur.
# ---------------------------------------------------------------------------

# URL publique du site (sans / final). Production : https://elvynarnaudrealty.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "true" uniquement sur le déploiement de production avec le catalogue réel (sinon noindex partout)
ALLOW_INDEXING=false

# --- AlterEstate (catalogue) ------------------------------------------------
# AlterEstate → Paramètres → Mon compte → "API KEY PUBLICO" (clé PUBLIQUE, pas la clé privée)
# Vide = mode démonstration (instantané du site public du 24/11/2026, non synchronisé)
ALTERESTATE_PUBLIC_TOKEN=
ALTERESTATE_API_BASE=https://secure.alterestate.com/api/v1
ALTERESTATE_COMPANY_ID=2040
# Durée du cache des annonces (s) et durée maximale de données anciennes servies si AlterEstate est indisponible (s)
CATALOG_CACHE_SECONDS=600
CATALOG_MAX_STALE_SECONDS=21600

# --- Base de données du CRM ---------------------------------------------------
# PostgreSQL en production (Neon, Supabase, …). Vide = PGlite local dans .data/ (aperçu uniquement)
DATABASE_URL=
DB_AUTO_MIGRATE=true

# --- Espace privé -------------------------------------------------------------
# Chaîne aléatoire d'au moins 32 caractères : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_HOURS=8

# --- Assistant IA (Anthropic) -------------------------------------------------
# Vide = l'assistant fonctionne en mode "contact direct" (catalogue, WhatsApp, téléphone)
ANTHROPIC_API_KEY=
AI_ENABLED=true
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
AI_MAX_OUTPUT_TOKENS=1500
AI_MONTHLY_BUDGET_USD=40
AI_DAILY_MESSAGE_LIMIT=400
AI_MAX_TURNS_PER_SESSION=30
AI_MAX_TOOL_ROUNDS=5
AI_RATE_LIMIT_PER_IP_10MIN=25

# --- Règles CRM ----------------------------------------------------------------
PRIORITY_BUDGET_USD=150000
# Taux DOP par USD pour comparer les budgets en pesos au seuil de priorité (vide = pas de conversion)
USD_DOP_RATE=
CHAT_RETENTION_DAYS=30
INACTIVE_CONTACT_RETENTION_MONTHS=24

# --- Notifications -------------------------------------------------------------
# test = enregistrées dans le CRM sans envoi ; live = envoi réel
NOTIFY_MODE=test
NOTIFY_EVENTS=lead.created,lead.hot,visit.requested,handoff.requested
NOTIFY_EMAIL_TO=
EMAIL_FROM=
RESEND_API_KEY=
# WhatsApp automatique (WhatsApp Cloud API de Meta, modèle approuvé requis)
WHATSAPP_NOTIFY=false
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NOTIFY_TO=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=es
WHATSAPP_NOTIFY_EVENTS=lead.hot,visit.requested

# --- Calendrier ---------------------------------------------------------------
CALENDAR_PROVIDER=none

# --- Tâche quotidienne (purge + nouvelles tentatives) ----------------------------
CRON_SECRET=

# --- Premier utilisateur (aperçus dont la base démarre vide) -------------------
# Hash généré par `npm run admin:hash` (jamais le mot de passe en clair)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_PASSWORD_HASH=
# Autorise PGlite hors développement (aperçu seulement : données non persistantes sur Vercel)
ALLOW_PGLITE_IN_PRODUCTION=false
PGLITE_DIR=.data/pglite

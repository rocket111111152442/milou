# --- Studio (générateur de sites) ------------------------------------------
# Mot de passe du Studio (/studio), et clé de signature des sessions
ADMIN_PASSWORD=
# Fourni automatiquement par Vercel quand le Blob store est relié au projet.
# Sans ce jeton, en local, les données sont écrites dans le dossier .data/
BLOB_READ_WRITE_TOKEN=

# --- Notifications de commandes (facultatif) -------------------------------
# Générer les clés : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@exemple.fr

# --- E-mails de commandes (facultatif) -------------------------------------
# Les commandes sont de toute façon enregistrées dans l'espace boutiques de chaque site.
# Avec RESEND_API_KEY, chaque site peut aussi recevoir ses commandes par e-mail
# (adresse saisie dans le Studio).
RESEND_API_KEY=
# Expéditeur : doit appartenir à un domaine vérifié dans Resend
ORDER_EMAIL_FROM="Commandes <commandes@votre-domaine.fr>"

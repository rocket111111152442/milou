{
  "redirects": [
    { "source": "/bien.html", "has": [{ "type": "query", "key": "id", "value": "(?<id>[\\w-]+)" }], "destination": "/bien/:id", "permanent": true },
    { "source": "/bien.html", "destination": "/biens", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/router?__path=:path*" },
    { "source": "/bien/:id", "destination": "/api/router?__path=ssr/bien/:id" },
    { "source": "/immobilier/:slug", "destination": "/api/router?__path=ssr/ville/:slug" },
    { "source": "/sitemap.xml", "destination": "/api/router?__path=ssr/sitemap" },
    { "source": "/robots.txt", "destination": "/api/router?__path=ssr/robots" },
    { "source": "/biens", "destination": "/biens.html" },
    { "source": "/admin", "destination": "/admin/index.html" }
  ],
  "functions": {
    "api/router.js": { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/cron/daily", "schedule": "0 4 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-src https://www.google.com https://my.matterport.com https://www.youtube-nocookie.com https://player.vimeo.com https://player.previsite.net; form-action 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'" }
      ]
    },
    { "source": "/admin/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/(.*)\\.(js|css)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}

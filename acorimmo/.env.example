# Variables d'environnement — à définir dans Vercel (Settings → Environment Variables).
# Ne jamais mettre de vraie valeur dans ce fichier ni dans le code.

# --- Obligatoires ---
SESSION_SECRET=          # 64 caractères aléatoires : signe les sessions admin
ADMIN_EMAIL=             # e-mail du premier compte (propriétaire), créé à la première connexion
ADMIN_PASSWORD=          # mot de passe provisoire de ce compte (à changer à la première connexion)
ADMIN_NAME=              # nom affiché du propriétaire (facultatif)
BLOB_READ_WRITE_TOKEN=   # ajouté automatiquement en reliant un store Vercel Blob PRIVÉ au projet

# --- Recommandées ---
CRON_SECRET=             # active la tâche quotidienne (sauvegarde, nettoyage, alertes)
SITE_URL=                # adresse publique du site, pour les liens dans les e-mails

# --- E-mails (à connecter) : https://resend.com/docs/api-reference/emails/send-email ---
RESEND_API_KEY=
EMAIL_FROM=              # ex. "Acor’Immo <contact@domaine-verifie.fr>"
NOTIFY_EMAIL=            # destinataire des notifications de nouvelles demandes (sinon : e-mail de config/agence.js)

# --- Synchronisation avec un logiciel externe (à connecter, voir docs/API.md) ---
SYNC_API_KEY=

# --- Développement local uniquement ---
# STORAGE=fs             # stocke les données dans .data/ au lieu de Vercel Blob

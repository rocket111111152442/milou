{
  "manifest_version": 3,
  "name": "Waverti — Relevé navigateur",
  "version": "0.2.0",
  "description": "Envoie l’adresse d’une page et ses éventuelles données produit à l’assistant Waverti.",
  "permissions": ["activeTab", "scripting"],
  "icons": {
    "32": "32x32.png",
    "128": "128x128.png"
  },
  "action": {
    "default_title": "Envoyer une page à Waverti",
    "default_icon": {
      "32": "32x32.png",
      "128": "128x128.png"
    },
    "default_popup": "popup.html"
  }
}

# =============================================================================
# WAVERTI — variables d'environnement (modèle, AUCUN secret réel ici)
# Détail de chaque variable : docs/ENVIRONMENT.md
# Application web : copier les variables utiles dans apps/web/.env.local (développement)
# ou dans les variables du projet Vercel « waverti » (Preview / Production).
# Worker : infra/docker/worker.env (voir infra/docker/worker.env.example).
# =============================================================================

# --- Application ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# preview | live : « preview » affiche le bandeau « version de démonstration » et interdit l'indexation.
NEXT_PUBLIC_LAUNCH_STATUS=preview

# --- PostgreSQL auto-hébergé (données + comptes) ------------------------------------
# Connexion du serveur web et du worker (TLS obligatoire hors réseau local : ?sslmode=verify-full).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/waverti
# Connexion directe pour les migrations (rôle autorisé à créer le rôle app_user), facultative.
DATABASE_URL_DIRECT=
DATABASE_POOL_MAX=5

# --- Sécurité -----------------------------------------------------------------
# 32 caractères minimum, aléatoire (openssl rand -hex 32). Sert à pseudonymiser e-mails/cartes (anti-abus des essais).
WAVERTI_HASH_PEPPER=
# 1 = l'administration exige la double authentification (TOTP, Paramètres > Double authentification). Recommandé en production.
ADMIN_REQUIRE_MFA=0
# 32 octets aléatoires (openssl rand -base64 32) : chiffrement des secrets de double authentification.
# Ne JAMAIS la changer sans procédure (les secrets TOTP existants deviendraient illisibles).
WAVERTI_ENCRYPTION_KEY=

# --- Stripe (MODE TEST UNIQUEMENT) ----------------------------------------------
# Les clés sk_live_ sont refusées tant que WAVERTI_ALLOW_LIVE_PAYMENTS n'est pas renseigné
# (à ne faire qu'après validation juridique et ouverture du compte marchand).
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
# Tests uniquement : rediriger les appels vers stripe-mock (http://localhost:12111).
STRIPE_API_BASE=
WAVERTI_ALLOW_LIVE_PAYMENTS=
# Identifiants des prix Stripe (mode test), utilisés par « pnpm db:seed ».
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_BUSINESS_EXTRA_SITE=

# --- E-mails — site (vérification d'adresse, mot de passe) et worker (alertes) -------
# Resend (prioritaire) ou, à défaut, un serveur SMTP (smtp://utilisateur:motdepasse@hote:587).
RESEND_API_KEY=
SMTP_URL=
EMAIL_FROM=Waverti <alertes@waverti.com>

# --- Recherche sur Internet (Brave Search API) — worker ---------------------------
BRAVE_SEARCH_API_KEY=
# Ancien nom accepté (BRAVE_SEARCH_API_KEY est prioritaire).
# BRAVE_API_KEY=

# --- Worker -----------------------------------------------------------------------
APP_URL=http://localhost:3000
WORKER_ID=
WORKER_ROLES=scheduler,pages,web,business,email,maintenance
WORKER_PAGE_CONCURRENCY=8
WORKER_WEB_CONCURRENCY=2
WORKER_BROWSER_CONCURRENCY=2
WORKER_BUSINESS_CONCURRENCY=16
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
LOG_LEVEL=info
# Développement / tests uniquement : autorise des cibles locales. Refusé si NODE_ENV=production.
WAVERTI_ALLOW_PRIVATE_TARGETS=0

# --- Application desktop (variables de COMPILATION) --------------------------------
# Adresse du serveur Waverti intégrée à l'application (https:// obligatoire en release).
WAVERTI_API_URL=http://localhost:3000

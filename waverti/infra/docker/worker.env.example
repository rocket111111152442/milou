# Copier en worker.env (NON versionné) et compléter. Voir docs/ENVIRONMENT.md.
# PostgreSQL auto-hébergé (même serveur ou réseau privé) ; TLS obligatoire si la base est distante.
DATABASE_URL=postgresql://waverti:MOT_DE_PASSE@127.0.0.1:5432/waverti
WORKER_ID=ovh-worker-1
APP_URL=https://www.waverti.com
EMAIL_FROM=Waverti <alertes@waverti.com>
RESEND_API_KEY=
# Alternative à Resend : SMTP_URL=smtp://utilisateur:motdepasse@hote:587
SMTP_URL=
BRAVE_SEARCH_API_KEY=
# Clé Stripe en MODE TEST uniquement (sk_test_…) — utilisée pour les rappels d'essai.
STRIPE_SECRET_KEY=
WORKER_PAGE_CONCURRENCY=8
WORKER_BUSINESS_CONCURRENCY=16
WORKER_BROWSER_CONCURRENCY=2
LOG_LEVEL=info

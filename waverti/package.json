{
  "name": "waverti",
  "private": true,
  "version": "0.1.0",
  "description": "WAVERTI — assistant intelligent de surveillance d'Internet. Développé par LULLIN WEB.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm --filter @waverti/web test:e2e",
    "db:migrate": "tsx packages/database/scripts/migrate.ts",
    "db:seed": "tsx packages/database/scripts/seed.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "admin:grant": "tsx packages/database/scripts/grant-admin.ts",
    "test:load": "WAVERTI_LOAD_TESTS=1 vitest run --project load",
    "stripe:prices": "tsx packages/billing/scripts/stripe-prices.ts"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.0",
    "tsx": "^4.23.0",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "@waverti/config": "workspace:*",
    "@waverti/database": "workspace:*"
  },
  "type": "module"
}

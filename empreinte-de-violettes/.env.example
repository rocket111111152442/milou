# --- Accès administration (/admin) ---
# Mot de passe de l'espace fleuriste (par défaut « violettes » : À CHANGER)
ADMIN_PASSWORD=
# Chaîne aléatoire longue pour signer la session (ex. `openssl rand -hex 32`)
AUTH_SECRET=

# --- Adresse publique du site (liens des e-mails, Stripe, sitemap) ---
NEXT_PUBLIC_SITE_URL=https://www.empreintedeviolettes.fr

# --- Base de données : Upstash Redis (gratuit) ---
# Vercel > Storage > Upstash (Redis) crée automatiquement KV_REST_API_URL / KV_REST_API_TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Paiement Stripe ---
# Clé secrète (sk_test_… pour tester, sk_live_… en production)
STRIPE_SECRET_KEY=
# Secret du webhook (whsec_…) — endpoint : https://VOTRE-DOMAINE/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# --- E-mails transactionnels : Resend ---
RESEND_API_KEY=
# Expéditeur vérifié dans Resend
EMAIL_FROM="Empreinte de Violettes <commandes@empreintedeviolettes.fr>"

# --- Photos téléversées depuis l'admin : Vercel Blob (facultatif) ---
BLOB_READ_WRITE_TOKEN=
